TYPESENSE_ADMIN_API_KEY=uplate-dev-key
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# PRIMARY query understanding: Typesense NL Search Models (app/typesense/nl_model.py).
# Typesense orchestrates a third-party LLM; supported providers are OpenAI, Google
# Gemini, GCP Vertex, Cloudflare Workers AI and self-hosted vLLM. Anthropic is NOT
# among them, which is why the Claude path below exists separately.
# Google AI Studio key: https://aistudio.google.com/apikey
NL_LLM_API_KEY=
NL_LLM_MODEL_NAME=google/gemini-3.1-flash-lite
NL_MODEL_ID=uplate-nl

# FALLBACK only, used when the Typesense NL path fails (app/llm/interpreter.py).
# Optional — leave blank and search degrades straight to keyword.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

ALLOWED_ORIGINS=http://localhost:5173
CAMPUS_ID=purdue

# Dev-only: serve fixture data from /api/search so frontend work doesn't need a
# running Typesense. Fixture data does NOT honor allergen exclusions, so keep
# this false for anything resembling a demo. Responses are stamped as fixtures.
USE_FIXTURES=false

# Search only off-campus retail. UPlate already covers dining courts and On the
# Gos natively; this product is the retail half. Query-time filter, so flipping
# this to false immediately includes dining courts with no reindex.
RETAIL_ONLY=true
